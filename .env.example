# ─────────────────────────────────────────────────────────
# متغيرات البيئة — نظام المقابلات الذكي
# انسخ هذا الملف إلى .env وعدّل القيم
# ─────────────────────────────────────────────────────────

ENVIRONMENT=development

# ─── قاعدة البيانات ───
DB_DATABASE=interview_db
DB_USERNAME=interview_user
DB_PASSWORD=interview_pass_2026

# ─── Redis ───
REDIS_PASSWORD=redis_pass_2026

# ─── FastAPI — API Key ───
# غيّر هذه القيمة لشيء آمن قبل الإنتاج
FASTAPI_API_KEY=dev-api-key-change-in-production

# ─── Whisper ───
# base = أسرع وأخف (مناسب لـ 8GB)
# small = أدق قليلًا
WHISPER_MODEL=base
