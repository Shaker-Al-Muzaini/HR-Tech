!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── OS ───
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ───
.dockerignore
docker-compose.override.yml

# ─── MyPy / Pyright ───
pyrightconfig.json
'@ | Out-File -FilePath ".gitignore" -Encoding UTF8; Write-Host "✅ fastApi/.gitignore created"