cd "D:\HR Tech\fastApi"; @'
# ═══════════════════════════════════════════════════════════
# 🐍 FastAPI + AI Pipelines — .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Python Virtual Environments ───
venv/
env/
ENV/
.venv/
.ENV/
env.bak/
venv.bak/

# ─── Python Bytecode ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ─── Distribution / Packaging ───
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Unit Test / Coverage ───
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/
.tox/
.nox/
coverage.xml
*.lcov
.nyc_output

# ─── Type Checking / Linting ───
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/
.pyre/
.pylint.d/

# ─── Environment Variables ───
.env
.env.*
!.env.example

# ─── FastAPI / Uvicorn ───
*.pid
*.seed
*.pid.lock

# ═══════════════════════════════════════════════════════════
