runs/
weights/
.datasets/
*.cache

# ─── Whisper / Mediapipe Cache ───
.cache/
.whisper/
.mediapipe/

# ─── FFmpeg / Video ───
ffmpeg-*/
ffprobe-*/

# ─── Logs ───
logs/
*.log
!requirements.txt

# ─── Alembic (keep migrations, ignore nothing here) ───
